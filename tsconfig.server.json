{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "outDir": "./public",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "lib": ["esnext"],
    "jsx": "react-jsx"
  },
  "include": [
    "server/**/*.ts",
    "server/**/*.d.ts",
    "shared/**/*.ts",
    "migrations/**/*.ts"
  ],
  "exclude": ["node_modules", "build", "**/public/**"]
}
