{
  "name": "recipe-stash",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "description": "It's a common problem for many internet chefs; you find a recipe you want to try, pin it on Pinterest.com, come back 6 months later and find that the domain for the recipe no longer exists. Or you try something you really love, write it down on a recipe card to put in your recipe box, and then think to yourself \"What if my house burned down? I wouldn't even have this anymore.\" Or maybe you got halfway through and thought \"This is too much work\".",
  "type": "module",
  "main": "server.js",
  "proxy": "http://localhost:3000",
  "scripts": {
    "dev": "webpack-dev-server --config ./webpack.config.js --mode development --stats-error-details",
    "dev-server": "dotenv -e ./.env.development -- nodemon --exec \"node --import tsx\" ./server/server.ts",
    "migrate": "node-pg-migrate -m migrations",
    "migrate:create": "node-pg-migrate -m migrations -j ts create",
    "migrate:dev": "node-pg-migrate -m migrations --envPath .env.development up",
    "migrate:down:dev": "node-pg-migrate -m migrations --envPath .env.development down",
    "migrate:prod": "node-pg-migrate -m migrations --check-order --single-transaction --lock up",
    "test:migrations": "sh ./scripts/test-migrations.sh",
    "start": "NODE_ENV=production node ./public/server/server.js",
    "start:prod-local": "sh -c '(sleep 1; open http://localhost:3000) & exec env NODE_ENV=production node --env-file=.env ./public/server/server.js'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "pnpm test:e2e && pnpm build:app",
    "build:app": "BABEL_ENV=production webpack && tsc -p tsconfig.server.json"
  },
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baileypownell/Virtual-Cookbook.git"
  },
  "keywords": [
    "cooking"
  ],
  "author": "Bailey Pownell",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/baileypownell/Virtual-Cookbook/issues"
  },
  "homepage": "https://github.com/baileypownell/Virtual-Cookbook#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1081.0",
    "@aws-sdk/s3-request-presigner": "^3.1081.0",
    "@babel/runtime": "^8.0.0",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@tabler/icons-react": "^3.44.0",
    "@types/quill": "1.3.10",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "file-type": "^22.0.1",
    "formik": "^2.4.9",
    "html-to-text": "^10.0.0",
    "pg": "^8.22.0",
    "quill": "1.3.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-query": "^3.39.3",
    "react-router": "^7.18.1",
    "react-router-dom": "^7.18.1",
    "react-spring-lightbox": "1.8.0",
    "react-visibility-sensor": "^5.1.1",
    "resend": "^6.17.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@playwright/test": "^1.62.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "dotenv-cli": "^11.0.0",
    "html-webpack-plugin": "^5.6.7",
    "imagemin-webpack-plugin": "^2.4.2",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "style-loader": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
